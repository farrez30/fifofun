# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# knowledge graph output
graphify-out/

# never commit real financial data
*.xlsx
*.xls
*.pdf
/data/
/fixtures/private/

# local tooling scratch
.nextdocs
/tmp/

# agent tooling config (regenerated locally by next dev)
CLAUDE.md

# agent tooling
.claude/
skills-lock.json
# axe-core copied here on demand for accessibility audits against a real build
public/_axe.js
