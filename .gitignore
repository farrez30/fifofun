# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# knowledge graph output
graphify-out/

# never commit real financial data
#
# The extension list catches a statement dropped anywhere in the tree. The
# directories are listed separately because they exist only to hold the real
# thing, and guessing which extensions a bank will export next is the wrong way
# to protect a path whose entire contents are already known to be private.
*.xlsx
*.xls
*.pdf
*.csv
/e_statement_mandiri/
/data/
/fixtures/private/

# local tooling scratch
.nextdocs
/tmp/
.vscode/

# agent tooling config (regenerated locally by next dev)
CLAUDE.md

# agent tooling
.claude/
skills-lock.json
# axe-core copied here on demand for accessibility audits against a real build
public/_axe.js

# browser test output; the fixture pages are rendered by `pnpm test:e2e`
/e2e/.fixtures/
/test-results/
/playwright-report/
