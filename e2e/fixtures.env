# Read by `tsx --env-file` when building the fixtures (package.json test:e2e).
# The app shell imports the sign-out server action, which in a plain Node
# render is real code that builds the database client and Better Auth at import.
# Neither connects until a query runs, and no fixture runs one, so a placeholder
# is enough. A real DATABASE_URL in the environment wins over this file.
DATABASE_URL=postgres://fixtures@localhost:1/none
BETTER_AUTH_SECRET=fixtures-only-not-a-secret-0123456789abcdef
BETTER_AUTH_URL=http://localhost:3000
