# Copy to .env.local and fill in. Never commit .env.local.

# --- Database (Neon) --------------------------------------------------
# Direct endpoint. Used by Drizzle for migrations and seeding, both of which run
# from a laptop. Do not set it on the deployment platform: nothing there needs
# it, and leaving it out means a missing DATABASE_POOL_URL fails loudly instead
# of silently falling back to a connection that cannot survive serverless
# connection counts.
#   npx neonctl connection-string main --project-id silent-forest-61541759
DATABASE_URL=

# -pooler endpoint (PgBouncer). Used at runtime, where a connection is short.
#   npx neonctl connection-string main --project-id silent-forest-61541759 --pooled
DATABASE_POOL_URL=

# --- Auth (Better Auth) -----------------------------------------------
# This deployment's own origin, and the secret that signs session cookies
# (32+ random bytes; rotating it signs everybody out):
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=

# --- Telegram ---------------------------------------------------------
# Optional. The bot records cash, which no bank statement can ever see.
#
# The webhook writes to the ledger as the database owner and therefore without
# row level security, so these three are what stand between a public URL and
# somebody else's rows. Set all three or leave all three empty.

# From @BotFather.
TELEGRAM_BOT_TOKEN=

# Any long random string. Telegram echoes it back on every delivery, and a
# request without it is rejected before anything is parsed. Register it with:
#   curl -F "url=https://YOUR-DOMAIN/api/telegram" \
#        -F "secret_token=THIS_VALUE" \
#        https://api.telegram.org/botYOUR_TOKEN/setWebhook
TELEGRAM_WEBHOOK_SECRET=

# Comma-separated chat ids allowed to record entries. Anyone can message a bot
# once they know its username, so this list is the actual authentication.
# Find yours by messaging the bot and reading:
#   https://api.telegram.org/botYOUR_TOKEN/getUpdates
TELEGRAM_ALLOWED_CHAT_IDS=

# Which household the bot writes into.
TELEGRAM_HOUSEHOLD_ID=

# Public origin, used for absolute URLs in social cards.
NEXT_PUBLIC_SITE_URL=
